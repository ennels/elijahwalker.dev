---
// Built-in project icons. In content/projects.yaml, set `icon` to one of these names,
// or to an image path such as /icons/hermes.png (file goes in public/icons/).
// An unknown name stops the build, so a typo can't quietly show another project's icon.
const PATHS = {
  chart: '<path d="M6 3.5v17M12 5v14M18 3v18"/><rect x="4.4" y="8" width="3.2" height="7" rx=".6" fill="currentColor"/><rect x="10.4" y="10" width="3.2" height="5" rx=".6"/><rect x="16.4" y="6" width="3.2" height="9" rx=".6" fill="currentColor"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17M8 3v4M16 3v4M8.6 14.6l2.2 2.2 4.6-4.6"/>',
  database: '<ellipse cx="10" cy="5.5" rx="6" ry="2.5"/><path d="M4 5.5v11c0 1.4 2.7 2.5 6 2.5M16 5.5V10M4 11c0 1.4 2.7 2.5 6 2.5"/><path d="M15.5 14h6v2.5a3 3 0 0 1-6 0zM17 11.5V14M20 11.5V14M18.5 19.5V22"/>',
  chat: '<path d="M3.5 4.5h17v11H10l-4.5 4v-4h-2z"/><rect x="9" y="7.5" width="6" height="5" rx="1"/><path d="M10.5 6v1.5M13.5 6v1.5M10.5 12.5V14M13.5 12.5V14"/>',
  scatter: '<circle cx="6" cy="16" r="1.4" fill="currentColor"/><circle cx="8.5" cy="11.5" r="1.4" fill="currentColor"/><circle cx="5" cy="8" r="1.4" fill="currentColor"/><circle cx="16" cy="7.5" r="1.4"/><circle cx="18.5" cy="12.5" r="1.4"/><circle cx="15" cy="17" r="1.4"/><path d="M4 21.5C10 15 13.5 9 20.5 2.5" stroke-dasharray="2 2.4"/>',
  tag: '<path d="M3 11.5V4h7.5l10 10-7.5 7.5z"/><circle cx="7.5" cy="8" r="1.4"/><path d="M10.5 15.5l2-2M12.5 17.5l3.5-3.5"/>',
  record: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r=".7" fill="currentColor"/>',
};
const { name = 'record' } = Astro.props;
const isImage = typeof name === 'string' && name.startsWith('/');
if (!isImage && !PATHS[name]) {
  throw new Error(`Unknown project icon "${name}" in content/projects.yaml. Use one of: ${Object.keys(PATHS).join(', ')}, or an image path like /icons/name.png.`);
}
---
{isImage
  ? <img src={name} alt="" width="24" height="24" />
  : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={PATHS[name]} />}
