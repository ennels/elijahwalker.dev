---
// Decorative border for one section: its material in both side margins (mirrored), cut straight at the
// section's top and bottom. Wide screens only (1280+); the section's paper background carries the theme elsewhere.
//   material: 'kraft' (Projects) | 'liner' (About + Resume) | 'film' (Studio) | 'stamp' (Contact)
const { material } = Astro.props;
---
<div class={`sb sb-${material}`} aria-hidden="true">
  {['l', 'r'].map((side) => (
    <div class={`sb-side sb-${side}`}>
      {material === 'film' ? <div class="film-rail"></div> : <div class={`ply ply-${material}`}><i></i></div>}
    </div>
  ))}
</div>
