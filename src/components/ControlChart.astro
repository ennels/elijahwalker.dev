---
// Resume background: a control chart running down the page (time flows down, like the timeline). Center line,
// dashed upper and lower control limits, and a quiet trace that stays in control except one point past the
// upper limit. Decorative (aria-hidden). Fixed points, so it is the same on every build. The SVG stretches to the
// section's height; strokes and dots keep their size (non-scaling strokes; dots are zero-length round caps).
const N = 26;
let seed = 11;
const rnd = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
const pts = Array.from({ length: N }, (_, i) => {
  const y = 20 + (i * 960) / (N - 1);
  const x = i === 17 ? 93 : 50 + (rnd() - 0.5) * 50;
  return [x, y];
});
const trace = pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
---
<div class="spc" aria-hidden="true">
  <span class="spc-l" style="--x: 15%">LCL</span><span class="spc-l" style="--x: 50%">CL</span><span class="spc-l" style="--x: 85%">UCL</span>
  <svg viewBox="0 0 100 1000" preserveAspectRatio="none" focusable="false">
    <path class="spc-lim" d="M15 0 V1000 M85 0 V1000" />
    <path class="spc-cl" d="M50 0 V1000" />
    <polyline class="spc-trace" points={trace} />
    {pts.map(([x, y], i) => <path class={i === 17 ? 'spc-pt is-out' : 'spc-pt'} d={`M${x.toFixed(1)} ${y.toFixed(1)}h0`} />)}
  </svg>
</div>
