---
// hermes signal path, drawn from its description in content/projects.yaml.
// Two layouts of the same graph: horizontal for wide screens, vertical for phones (CSS picks one).
// Each step links to the file in github.com/ennels/hermes that does it. The boxes are a mouse shortcut
// (out of the tab order); the list under the figure carries the same links for keyboards and screen readers.
const REPO = 'https://github.com/ennels/hermes/blob/main/';
const NODES = [
  { id: 'clock', t: ['Weekdays', '9:45 ET'], s: 'APScheduler', file: 'main.py' },
  { id: 'feed', t: ['Prices', 'and news'], s: '', file: 'modules/data_fetcher.py' },
  { id: 'claude', t: ['Claude'], s: 'call per ticker', file: 'modules/signal_engine.py' },
  { id: 'gemini', t: ['Gemini'], s: 'call per ticker', file: 'modules/signal_engine.py' },
  { id: 'merge', t: ['Merge', 'the calls'], s: '', file: 'modules/arbitration.py' },
  { id: 'risk', t: ['Risk', 'rules'], s: '', file: 'modules/risk_filter.py' },
  { id: 'orders', t: ['Paper', 'orders'], s: 'Alpaca, no real money', file: 'modules/executor.py' },
];
// One row per file: Claude and Gemini share signal_engine.py.
const STEPS = [
  ['Weekdays at 9:45 ET', 'main.py'],
  ['Prices and news', 'modules/data_fetcher.py'],
  ['Claude and Gemini calls', 'modules/signal_engine.py'],
  ['Merge the calls', 'modules/arbitration.py'],
  ['Risk rules', 'modules/risk_filter.py'],
  ['Paper orders', 'modules/executor.py'],
];
const EDGES = [['clock', 'feed'], ['feed', 'claude'], ['feed', 'gemini'], ['claude', 'merge'], ['gemini', 'merge'], ['merge', 'risk'], ['risk', 'orders']];
const LABEL = 'hermes signal path: on weekdays at 9:45 ET it pulls prices and news, asks Claude and Gemini for a call on each ticker, merges the two calls, runs them through risk rules, and places paper orders through Alpaca.';

function layout(vertical) {
  const W = vertical ? 340 : 960, H = vertical ? 640 : 300;
  const bw = vertical ? 132 : 116, bh = 64;
  const P = vertical
    ? { clock: [170, 46], feed: [170, 150], claude: [86, 262], gemini: [254, 262], merge: [170, 374], risk: [170, 478], orders: [170, 586] }
    : { clock: [72, 150], feed: [222, 150], claude: [392, 76], gemini: [392, 224], merge: [562, 150], risk: [712, 150], orders: [878, 150] };
  const edges = EDGES.map(([a, b]) => {
    const [ax, ay] = P[a], [bx, by] = P[b];
    if (vertical) { const y1 = ay + bh / 2, y2 = by - bh / 2, my = (y1 + y2) / 2; return `M${ax} ${y1} V${my} H${bx} V${y2}`; }
    const x1 = ax + bw / 2, x2 = bx - bw / 2, mx = (x1 + x2) / 2;
    return `M${x1} ${ay} H${mx} V${by} H${x2}`;
  });
  const nodes = NODES.map((n) => {
    const [cx, cy] = P[n.id];
    return { ...n, cx, cy, x: cx - bw / 2, y: cy - bh / 2, ai: n.id === 'claude' || n.id === 'gemini' };
  });
  return { W, H, bw, bh, edges, nodes, cls: vertical ? 'diagram dg-v' : 'diagram dg-h' };
}
const views = [layout(false), layout(true)];
// Draw order for the entrance (motion.css): each node's step, and each edge takes the step of the node it feeds.
const STEP = { clock: 0, feed: 1, claude: 2, gemini: 2, merge: 3, risk: 4, orders: 5 };
const edgeStep = EDGES.map(([, b]) => STEP[b]);
---
<figure class="notes-panel">
  <div class="dg-wrap">
    {views.map((v) => (
      <svg class={v.cls} viewBox={`0 0 ${v.W} ${v.H}`} role="img" aria-label={LABEL}>
        {v.edges.map((d, i) => <path class="dg-edge" d={d} pathLength="1" style={`--k: ${edgeStep[i]}`} />)}
        {v.nodes.map((n) => (
          <a href={REPO + n.file} tabindex="-1" class="dg-link">
            <g class={n.ai ? 'dg-node dg-ai' : 'dg-node'} data-node={n.id} style={`--k: ${STEP[n.id]}`}>
              <rect x={n.x} y={n.y} width={v.bw} height={v.bh} rx="3" />
              {n.t.map((line, i) => <text class="dg-t" x={n.cx} y={n.cy + (n.t.length === 1 ? 5 : i * 17 - 3)} text-anchor="middle">{line}</text>)}
              {n.s && <text class="dg-s" x={n.cx} y={n.y + v.bh + 17} text-anchor="middle">{n.s}</text>}
            </g>
          </a>
        ))}
      </svg>
    ))}
  </div>
  <figcaption>Signal path, drawn from the project description. Click a step to open its code.</figcaption>
</figure>
<section class="sec steps" aria-labelledby="h-steps">
  <h2 class="sh small" id="h-steps">Where each step lives</h2>
  <dl class="steps-list">
    {STEPS.map(([step, file]) => (
      <div><dt>{step}</dt><dd><a href={REPO + file}><code>{file}</code></a></dd></div>
    ))}
  </dl>
</section>

<script>
  // Draw the signal path once, in order, when a third of it is in view. Without JS or with reduced motion it is simply there.
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!still && 'IntersectionObserver' in window) {
    document.querySelectorAll('.notes-panel .dg-wrap').forEach((wrap) => {
      wrap.classList.add('dg-armed');
      void wrap.offsetWidth; // commit the hidden state so the first frame can transition from it
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        wrap.classList.add('dg-play');
        io.disconnect();
      }, { threshold: 0.33 });
      io.observe(wrap);
    });
  }
</script>
