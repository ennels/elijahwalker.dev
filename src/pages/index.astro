---
// Homepage, laid out as a record: the cover, Side A (engineering), liner notes, and Side B (studio).
// Every old #anchor still lands: #top, #projects, #p-<id>, #notes, #about, #now, #resume, #media, #contact, #footer.
import Base from '../layouts/Base.astro';
import ProjectName from '../components/ProjectName.astro';
import FilmStrip from '../components/FilmStrip.astro';
import SectionEdge from '../components/SectionEdge.astro';
import { profile, projects, media, resume, notes, now, studio, hasStudio } from '../lib/content.js';

const initials = (name) => {
  const words = name.trim().split(/\s+/);
  const seg = new Intl.Segmenter('en', { granularity: 'grapheme' });
  const first = (w) => [...seg.segment(w)][0]?.segment ?? '';
  return (first(words[0]) + (words.length > 1 ? first(words.at(-1)) : '')).toUpperCase();
};

// Studio intro names only what's there.
const kinds = [studio.drawings.length && 'drawings', studio.photos.length && 'photographs', studio.music.length && 'music', media.length && 'design work'].filter(Boolean);
const list = kinds.length > 1 ? `${kinds.slice(0, -1).join(', ')}${kinds.length > 2 ? ',' : ''} and ${kinds.at(-1)}` : kinds[0] ?? '';
const studioIntro = list ? list[0].toUpperCase() + list.slice(1) + '.' : '';

// Edge-print numbers run through the whole studio, as on one roll.
const photoStart = 1 + studio.drawings.length;
const mediaStart = photoStart + studio.photos.length;
const [user, domain] = profile.email.split('@');
---
<Base>
  <main id="main" tabindex="-1">
    <section class="cover" id="top" aria-labelledby="name">
      <figure class="sleeve">
        <span class="sleeve-mono" aria-hidden="true">{initials(profile.name)}</span>
        {profile.photo && <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="460" height="460" fetchpriority="high" data-fallback />}
      </figure>
      <div class="cover-text">
        <h1 id="name">{profile.name.split(/\s+/).map((w, i) => <>{i > 0 && ' '}<span>{w}</span></>)}</h1>
        <p class="lede">{profile.headline}</p>
        <p class="cta">
          {projects.length > 0 && <a class="btn btn-solid" href="#projects">Projects</a>}
          <a class={projects.length ? 'btn' : 'btn btn-solid'} href="#contact">Contact</a>
          <a class="btn" href={profile.github}>GitHub</a>
          <a class="btn" href={profile.linkedin}>LinkedIn</a>
        </p>
        <p class="where">{profile.location}</p>
      </div>
    </section>

    {projects.length > 0 && (
      <section class="sec" id="projects" aria-labelledby="h-projects">
        <SectionEdge material="kraft" />
        <h2 class="sh" id="h-projects"><span class="side" aria-hidden="true">A</span>Projects</h2>
        <ol class="tracks">
          {projects.map((p, i) => (
            <li class={p.featured ? 'track is-feat' : 'track'} id={`p-${p.id}`}>
              <span class="no" aria-hidden="true">A{i + 1}</span>
              <div class="t-main">
                <h3 class="t-title"><ProjectName project={p} /></h3>
                <p class="t-label">{p.label}{p.status && <> <span class="t-status">{p.status}</span></>}</p>
                <p class="t-desc">{p.featured && p.description ? p.description : p.summary}</p>
                {p.stack?.length > 0 && <p class="credits"><span>Built with</span> {p.stack.join(', ')}</p>}
                {p.links?.length > 0 && <p class="t-links">{p.links.map((l) => <a href={l.url}>{l.label}</a>)}</p>}
              </div>
            </li>
          ))}
        </ol>
        {notes.items?.length > 0 && (
          <div class="aside-list" id="notes">
            <h3>Lab notes</h3>
            {notes.intro && <p class="muted">{notes.intro}</p>}
            <ul>
              {notes.items.map((n) => (
                <li><span class="al-t">{n.url ? <a href={n.url}>{n.title}</a> : n.title}</span><span class="muted">{n.tag}, {n.date || 'in progress'}</span></li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    <div class="liner-notes">
    <SectionEdge material="liner" />
    <section class="sec" id="about" aria-labelledby="h-about">
      <h2 class="sh" id="h-about">About</h2>
      <div class="liner">
        <div class="prose">{profile.about.map((t) => <p>{t}</p>)}</div>
        {profile.facts?.length > 0 && (
          <dl class="credits-list">{profile.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
        )}
      </div>
      {now.items?.length > 0 && (
        <div class="aside-list now" id="now">
          <h3>Now</h3>
          {now.updated && <p class="muted">Updated {now.updated}</p>}
          <ul>{now.items.map((t) => <li><span>{t}</span></li>)}</ul>
        </div>
      )}
    </section>

    <section class="sec" id="resume" aria-labelledby="h-resume">
      <h2 class="sh" id="h-resume">Resume</h2>
      <ol class="cv">
        {resume.entries.map((r) => (
          <li><p class="when">{r.when}</p><div><h3>{r.title}</h3><p class="org">{r.org}</p>{r.text && <p>{r.text}</p>}</div></li>
        ))}
      </ol>
      {resume.skills?.length > 0 && (
        <dl class="credits-list wide">{resume.skills.map((k) => <div><dt>{k.label}</dt><dd>{k.value}</dd></div>)}</dl>
      )}
      {profile.resume_pdf && <p class="cta"><a class="btn btn-solid" href={profile.resume_pdf} download>Download resume (PDF)</a></p>}
    </section>
    </div>

    {hasStudio() && (
      <section class="side-b" id="studio" aria-labelledby="h-studio">
        <SectionEdge material="film" />
        <div class="side-b-in">
          <h2 class="sh" id="h-studio"><span class="side" aria-hidden="true">B</span>Studio</h2>
          <p class="intro">{studioIntro}</p>
          {studio.drawings.length > 0 && (
            <div class="roll"><h3>Drawings</h3><FilmStrip items={studio.drawings} label="Drawings" format="square" start={1} /></div>
          )}
          {studio.photos.length > 0 && (
            <div class="roll"><h3>Photographs</h3><FilmStrip items={studio.photos} label="Photographs" start={photoStart} /></div>
          )}
          {studio.music.length > 0 && (
            <div class="roll"><h3>Music</h3>
              <ul class="audio">
                {studio.music.map((m) => (
                  <li>
                    <div class="a-text"><span class="tt">{m.title}</span>{m.note && <span class="a-meta">{m.note}</span>}</div>
                    <audio controls preload="none" src={m.audio} aria-label={m.title}></audio>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {media.length > 0 && (
            <div class="roll" id="media"><h3>Media and design</h3>
              <ul class="sheet">
                {media.map((m, i) => (
                  <li class="shot">
                    <FilmStrip items={[{ title: m.title, image: m.image, note: m.meta }]} label={m.title} format="single" start={mediaStart + i} />
                    <div class="cap"><h4>{m.title}</h4><p class="kind">{m.meta}</p><p>{m.description}</p></div>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )}

    <section class="sec contact" id="contact" aria-labelledby="h-contact">
      <SectionEdge material="stamp" />
      <h2 class="sh" id="h-contact">{profile.contact_heading}</h2>
      <p class="muted">{profile.contact_text}</p>
      <p class="mail"><span id="email">{user}<wbr />@{domain}</span><button type="button" class="btn" data-copy={profile.email} aria-controls="email">Copy email</button></p>
      <p class="t-links big"><a href={profile.github}>GitHub</a><a href={profile.linkedin}>LinkedIn</a></p>
    </section>
  </main>

  <script>
    import '../scripts/home.js';
  </script>
</Base>
