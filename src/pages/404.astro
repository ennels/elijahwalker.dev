---
import '../styles/site.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Signal lost · Elijah Walker</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400..800&display=swap" />
</head>
<body style="min-height:100vh;display:grid;place-items:center;background:var(--hero-bg);color:var(--hero-ink)">
  <main class="wrap" style="text-align:center;padding-block:64px">
    <p class="mono" style="color:var(--hero-muted)">404</p>
    <h1 style="font-weight:800;font-size:clamp(2rem,1.4rem + 3vw,3.5rem);letter-spacing:-.03em;margin:.3em 0">Signal lost</h1>
    <p style="color:var(--hero-muted);max-width:28rem;margin:0 auto 28px">This page drifted out of orbit. The rest of the site is still on course.</p>
    <a class="btn" href="/" style="border-color:var(--hero-ink);color:var(--hero-ink)">Back to the launch pad</a>
  </main>
</body>
</html>
