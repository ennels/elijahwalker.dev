---
import Base from '../layouts/Base.astro';
import { profile } from '../lib/content.js';
---
<Base title={`Signal lost · ${profile.name}`} description="Page not found." noindex>
  <main id="main" class="sec lost" tabindex="-1">
    <p class="muted">404</p>
    <h1>Signal lost</h1>
    <p class="muted">This page drifted out of orbit. The rest of the site is still on course.</p>
    <p><a href="/">Back to the launch pad</a></p>
  </main>
</Base>
