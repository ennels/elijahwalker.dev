---
// One page per project at /projects/<id>/. The homepage's #p-<id> anchors still work too.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProjectName from '../../components/ProjectName.astro';
import HermesDiagram from '../../components/HermesDiagram.astro';
import SectionEdge from '../../components/SectionEdge.astro';
import { projects, profile, projectHref } from '../../lib/content.js';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project: p } = Astro.props;
---
<Base title={`${p.name} · ${profile.name}`} description={p.summary} path={projectHref(p.id)} bodyClass="is-project">
  <main id="main" class="pp" tabindex="-1">
    <SectionEdge material="kraft" />
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/#projects">Projects</a><span aria-hidden="true">/</span><span aria-current="page">{p.name}</span></nav>
    <section class="single" aria-labelledby="pp-title">
      <h1 class="pp-title" id="pp-title"><span class="pico"><Icon name={p.icon} /></span><span class="pname-t">{p.name}</span></h1>
      <p class="t-label">{p.label}{p.status && <> <span class="t-status">{p.status}</span></>}</p>
      <div class="liner">
        <div class="prose"><p class="lede">{p.summary}</p>{p.description && <p>{p.description}</p>}</div>
        <div class="pp-side">
          {p.stack?.length > 0 && <dl class="credits-list"><div><dt>Built with</dt><dd>{p.stack.join(', ')}</dd></div></dl>}
          {p.links?.length > 0
            ? <p class="cta">{p.links.map((l, j) => <a class={j === 0 ? 'btn btn-solid' : 'btn'} href={l.url}>{l.label}</a>)}</p>
            : <p class="muted">No public link yet.</p>}
        </div>
      </div>
    </section>

    {p.id === 'hermes' && <HermesDiagram />}

    <section class="sec" aria-labelledby="h-side">
      <h2 class="sh small" id="h-side"><span class="side" aria-hidden="true">A</span>All projects</h2>
      <ol class="mini">
        {projects.map((x, j) => (
          <li class={x.id === p.id ? 'is-here' : undefined}>
            <span class="no" aria-hidden="true">A{j + 1}</span>
            <ProjectName project={x} current={x.id === p.id} />
            <span class="muted">{x.label}</span>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>
