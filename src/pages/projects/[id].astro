---
// One page per project at /projects/<id>/. The homepage's #p-<id> anchors still work too.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProjectName from '../../components/ProjectName.astro';
import HermesDiagram from '../../components/HermesDiagram.astro';
import { projects, profile, projectHref } from '../../lib/content.js';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project: p } = Astro.props;
---
<Base title={`${p.name} · ${profile.name}`} description={p.summary} path={projectHref(p.id)} bodyClass="is-project" section="projects">
  <main id="main" class="pp" tabindex="-1">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/#projects">Projects</a><span aria-hidden="true">/</span><span aria-current="page">{p.name}</span></nav>
    <section class="single" aria-labelledby="pp-title">
      <h1 class="pp-title" id="pp-title"><span class="pico"><Icon name={p.icon} /></span><span class="pname-t">{p.name}</span></h1>
      <p class="t-label">{p.label}{p.status && <> <span class="t-status">{p.status}</span></>}</p>
      <div class="liner">
        <div class="prose"><p class="lede">{p.summary}</p>{p.description && <p>{p.description}</p>}</div>
        <div class="pp-side">
          {p.stack?.length > 0 && <dl class="credits-list"><div><dt>Built with</dt><dd>{p.stack.join(', ')}</dd></div></dl>}
          {p.links?.length > 0 && <p class="cta">{p.links.map((l, j) => <a class={j === 0 ? 'btn btn-solid' : 'btn'} href={l.url}>{l.label}</a>)}</p>}
        </div>
      </div>
    </section>

    {p.id === 'hermes' && <HermesDiagram />}

    {p.screens?.length > 0 && (
      <section class="sec screens" aria-labelledby="h-screens">
        <div class="screens-head">
          {p.screens_icon && <img class="app-icon" src={p.screens_icon} alt="" width="48" height="48" />}
          <h2 class="sh small" id="h-screens">Screens</h2>
          <p class="muted">Sample data: every name, email, and phone number is made up.</p>
        </div>
        <ul class="shots">
          {p.screens.map((s, i) => (
            <li class={i === 0 ? 'lead' : undefined}>
              <figure>
                <a href={`/projects/${p.id}/${s.file}-1600.webp`}>
                  <img src={`/projects/${p.id}/${s.file}-800.webp`} srcset={`/projects/${p.id}/${s.file}-800.webp 800w, /projects/${p.id}/${s.file}-1600.webp 1600w`}
                    sizes={i === 0 ? '(min-width: 1240px) 1160px, 94vw' : '(min-width: 900px) 46vw, 94vw'}
                    width="1600" height="1005" alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                </a>
                <figcaption>{s.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="sec" aria-labelledby="h-side">
      <h2 class="sh small" id="h-side">All projects</h2>
      <ol class="mini">
        {projects.map((x) => (
          <li class={x.id === p.id ? 'is-here' : undefined}>
            <ProjectName project={x} current={x.id === p.id} />
            <span class="muted">{x.label}</span>
          </li>
        ))}
      </ol>
    </section>
  </main>
</Base>
